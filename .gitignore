# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/pubspec.lock
**/doc/api/
.dart_tool/
**/.dart_tool/
build/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Node.js
node_modules/
**/node_modules/
**/dist/
package-lock.json
**/package-lock.json
# ...except the MCP server's. That package is an application, not a published
# library, and npm's convention is that an application commits its lockfile so
# installs are reproducible. CI runs `npm ci`, which requires it.
!packages/self_test_mcp/package-lock.json

# Codex task specs: orchestration scaffolding, not shipped source.
.tasks/

# The DevTools panel's built bundle is part of the published package: DevTools
# loads it from extension/devtools/build, so a consumer who installs from
# pub.dev gets the tab only if this is committed. The blanket build/ rule above
# would have excluded it, which is why the tab could never have worked for
# anyone but us.
!extension/devtools/build/
!extension/devtools/build/**

# canvaskit is 31 of the bundle's 38 MB and DevTools already serves its own,
# so shipping a second copy costs every consumer that download for nothing.
extension/devtools/build/canvaskit/
